# ============================================================
# Пример настроек приложения «ТехноВзгляд»
# Скопируйте этот файл в .env и выполните php artisan key:generate.
# ============================================================

# Название сайта.
APP_NAME="ТехноВзгляд"

# Окружение: local — разработка.
APP_ENV=local

# Ключ шифрования. Заполняется командой php artisan key:generate.
APP_KEY=

# Показывать подробные ошибки (только для разработки).
APP_DEBUG=true

# Адрес локального сайта.
APP_URL=http://localhost:8000

# Часовой пояс и язык проекта.
APP_TIMEZONE=Europe/Moscow
APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

# Режим обслуживания хранится в файле.
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Количество PHP-воркеров встроенного сервера (необязательно).
# PHP_CLI_SERVER_WORKERS=4

# Сложность хеширования паролей bcrypt.
BCRYPT_ROUNDS=12

# Логи: общий стек и один файл laravel.log.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================================
# База данных PostgreSQL (изменено: было sqlite)
# Создайте базы news_site и news_site_testing в pgAdmin 4.
# ============================================================
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=news_site
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ============================================================
# Сессии хранятся в таблице sessions базы данных
# ============================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Трансляция событий, файлы и очереди.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Кеш хранится в таблице cache.
CACHE_STORE=database
# CACHE_PREFIX=

# Memcached и Redis в проекте не используются.
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================================
# Почта: письма не отправляются, а пишутся в лог
# ============================================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS в проекте не используется.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
